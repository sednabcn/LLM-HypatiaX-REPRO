++    runner_ok = rp.returncode == 0
++    tail = " | ".join((rp.stdout + rp.stderr).strip().splitlines()[-4:])[:400]
++    (a.out / "runner_validate.log").write_text(rp.stdout + rp.stderr, encoding="utf-8")
