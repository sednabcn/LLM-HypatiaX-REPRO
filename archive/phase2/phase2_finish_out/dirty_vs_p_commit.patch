      n_large = n[mask_large]\n        result[mask_large] = (n_large * np.log(n_large) \n                              - n_large \n                              + 0.5 * np.log(2 * np.pi * n_large))\n        return result\n    \n    log_prob = -lam + var_N * np.log(lam) - log_factorial(var_N)\n    prob = np.exp(log_prob)\n    return prob", "def formula(var_N):\n    import numpy as np\n    # Shannon diversity index for N equally abundant species\n    # or log of population size (common in biology/ecology)\n    H = np.log(var_N)\n    return H", "def formula(var_N):\n    # Avogadro's number\n    N_A = 6.022e+23\n    # Normalize population count by Avogadro's number\n    # This converts number of molecules/entities to moles\n    result = var_N / N_A\n    return result"], "candidate_train_r2": [-6.368842894515561, -5.062157874579144, -6.368842894515561], "candidate_r2_status": ["ok", "ok", "ok"], "candidate_extrap_r2_near": [-177.33331345732861, -146.00708809679134, -177.33331345732861], "candidate_extrap_r2_medium": [-6.264060692597644, -4.7960329473873635, -6.264060692597644], "candidate_extrap_r2_far": [-11.85834016416248, -12.024277165545072, -11.85834016416248], "candidate_r2_raw_far": [-11.85834016416248, -12.024277165545072, -11.85834016416248], "selected_index": 1, "selection_metric": "train_r2", "model_id_returned": "claude-sonnet-4-6", "effective_request_params": {"params": {"model": "claude-sonnet-4-6", "max_tokens": 2000, "temperature": 0.3}, "temperature_sent": true, "model_requested": "claude-sonnet-4-6", "api_requests_per_call": [1, 1, 1], "stop_reasons": ["end_turn", "end_turn", "end_turn"], "prompt_identical_across_calls": true, "candidate_errors": [null, null, null], "time_cap_hit": false, "time_cap_s": 1400.0}, "stop_reason": "end_turn", "prompt_sha256": "1d45c718ca446f6f827abc6b5d4a7367e95e648909b013139ba9586bcd3da61c", "prompt_inputs": ["description", "domain", "variable_names", "constants"], "train_data_sha256": "68b1e97fd82a025922bd35536716be632d124