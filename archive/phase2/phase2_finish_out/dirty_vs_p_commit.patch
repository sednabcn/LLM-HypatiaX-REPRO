)\n    ln_N_factorial = var_N * np.log(var_N) - var_N + 0.5 * np.log(2 * np.pi * var_N)\n    S = k_B * ln_N_factorial\n    return S", "def formula(var_N):\n    # Boltzmann constant (exact value as specified)\n    k_B = 1.381e-23\n    # Entropy as a function of number of microstates/configurations N\n    import numpy as np\n    S = k_B * np.log(var_N)\n    return S", "def formula(var_N):\n    import numpy as np\n    # Poisson probability P(N) = e^(-N) * N^N / N!\n    # Using log-space computation for numerical stability\n    # ln(P) = -N + N*ln(N) - ln(N!)\n    # Using Stirling: ln(N!) \u2248 N*ln(N) - N + 0.5*ln(2*pi*N)\n    var_N = np.asarray(var_N, dtype=float)\n    # Exact computation using log-gamma (Stirling generalization)\n    # ln(N!) = lgamma(N+1)\n    log_prob = -var_N + var_N * np.log(np.maximum(var_N, 1e-300)) - (\n        var_N * np.log(np.maximum(var_N, 1e-300)) - var_N + 0.5 * np.log(2 * np.pi * np.maximum(var_N, 1e-300))\n    )\n    # Simplifies to Stirling approximation result\n    result = 1.0 / np.sqrt(2 * np.pi * np.maximum(var_N, 1e-300))\n    return result"], "candidate_train_r2": [-6.1252239574928335, -6.1252239574928335, -6.119623609995338], "candidate_r2_status": ["ok", "ok", "ok"], "candidate_extrap_r2_near": [-181.34342003226698, -181.34342003226698, -181.25881953997825], "candidate_extrap_r2_medium": [-6.566685855295777, -6.566685855295777, -6.562846206766985], "candidate_extrap_r2_far": [-11.233620402640067, -11.233620402640067, -11.233781254658663], "candidate_r2_raw_far": [-11.233620402640067, -11.233620402640067, -11.233781254658663], "selected_index": 0, "selection_metric": "train_r2", "model_id_returned": "claude-sonnet-4-6", "effective_request_params": {"params": {"model": "claude-sonnet-4-6", "max_tokens": 2000, "temperature": 0.3}, "temperature_sent": true, "model_requested": "claude-sonnet-4-6", "api_requests_per_call": [1, 1, 1], "stop_reasons": ["end_turn", "end_turn", "end_turn"], "prompt_identical_across_calls": true, "candi