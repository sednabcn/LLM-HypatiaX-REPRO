    \n    # Rational approximation of inverse normal CDF (Beasley-Springer-Moro)\n    # For p = 0.95\n    confidence = 0.95\n    \n    # Coefficients for rational approximation of erfinv\n    # Using the approximation: z \u2248 sqrt(-2 * ln(1 - p)) for p close to 1\n    # More accurate: use the standard value\n    p = confidence\n    \n    # Abramowitz & Stegun approximation for inverse normal CDF\n    t = np.sqrt(-2.0 * np.log(1.0 - p))\n    c0 = 2.515517\n    c1 = 0.802853\n    c2 = 0.010328\n    d1 = 1.432788\n    d2 = 0.189269\n    d3 = 0.001308\n    \n    z_alpha = t - (c0 + c1 * t + c2 * t**2) / (1.0 + d1 * t + d2 * t**2 + d3 * t**3)\n    \n    # VaR = Position * sigma * z_alpha\n    VaR = P * sigma * z_alpha\n    \n    return VaR"], "candidate_train_r2": [0.9871054289548779, 0.9977541796739642, 0.9977520001397513], "candidate_r2_status": ["ok", "ok", "ok"], "candidate_extrap_r2_near": [0.5782351765165623, 0.9999998387276149, 0.9999992790006056], "candidate_extrap_r2_medium": [0.8361759956428334, 0.9999999783376243, 0.9999999031541591], "candidate_extrap_r2_far": [-3.560806017028841, 0.9999998387276149, 0.9999992790006056], "candidate_r2_raw_far": [-3.560806017028841, 0.9999998387276149, 0.9999992790006056], "selected_index": 1, "selection_metric": "train_r2", "model_id_returned": "claude-sonnet-4-6", "effective_request_params": {"params": {"model": "claude-sonnet-4-6", "max_tokens": 2000, "temperature": 0.3}, "temperature_sent": true, "model_requested": "claude-sonnet-4-6", "api_requests_per_call": [1, 1, 1], "stop_reasons": ["end_turn", "end_turn", "end_turn"], "prompt_identical_across_calls": true, "candidate_errors": [null, null, null], "time_cap_hit": false, "time_cap_s": 1400.0}, "stop_reason": "end_turn", "prompt_sha256": "bacb67efc38a689d34cc9b2eb758a0eced7760fbf3238b5e3fece277d8744a8f", "prompt_inputs": ["description", "domain", "variable_names", "constants"], "train_data_sha256": "7e2344bf855c02a045288c8592500866fbd106da28f294a9f03fc5404e7c8b1d", "fa