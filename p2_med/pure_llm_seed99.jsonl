{"equation": "Logistic Growth", "seed": 99, "system": "pure_llm", "arm": "P", "split_id": "derived:0f8c2e7dca3a", "attempt": 1, "git_commit": "11c8cc3821ab5e611400b3c5c63b5dd62699027b+dirty", "evaluator_sha256": "7d5395ed728323d8db8b0a5e9e6804a2b142a401c8d7fe4d19d54b32973b7971", "config_sha256": "b7dd79895a4a96c875ecbd4cc21693931a8e2042a50939730f593988625db4bb", "prompt_template_sha256": "852d551b69b7fd3cf80d3b2f7e611952f7eb8e4aeb0853e8a59abeea2d3c3e1c", "created_utc": "2026-10-27T16:25:49.879891+00:00", "r2": -6.562846206766985, "r2_raw": -6.562846206766985, "r2_status": "ok", "extrap_r2_far": -11.233781254658663, "extrap_r2_medium": -6.562846206766985, "extrap_r2_near": -181.25881953997825, "train_r2": -6.119623609995338, "best_expression": "def formula(var_N):\n    import numpy as np\n    # Poisson probability P(N) = e^(-N) * N^N / N!\n    # Using log-space computation for numerical stability\n    # ln(P) = -N + N*ln(N) - ln(N!)\n    # Using Stirling: ln(N!) \u2248 N*ln(N) - N + 0.5*ln(2*pi*N)\n    var_N = np.asarray(var_N, dtype=float)\n    # Exact computation using log-gamma (Stirling generalization)\n    # ln(N!) = lgamma(N+1)\n    log_prob = -var_N + var_N * np.log(np.maximum(var_N, 1e-300)) - (\n        var_N * np.log(np.maximum(var_N, 1e-300)) - var_N + 0.5 * np.log(2 * np.pi * np.maximum(var_N, 1e-300))\n    )\n    # Simplifies to Stirling approximation result\n    result = 1.0 / np.sqrt(2 * np.pi * np.maximum(var_N, 1e-300))\n    return result", "generation_path": "pure_llm_best_of_3_train_r2", "call_index": 3, "n_calls": 3, "candidate_formulas": ["def formula(var_N):\n    import numpy as np\n    k_B = 1.381e-23\n    # Biological entropy / Boltzmann entropy for N distinguishable particles\n    # Using Stirling's approximation: ln(N!) \u2248 N*ln(N) - N for large N\n    # For exact computation with numpy:\n    # ln(N!) = sum of ln(k) for k=1..N, approximated by gammaln\n    # Use Stirling: N*ln(N) - N + 0.5*ln(2*pi*N)\n    var_N = np.asarray(var_N, dtype=float)\n    ln_N_factorial = var_N * np.log(var_N) - var_N + 0.5 * np.log(2 * np.pi * var_N)\n    S = k_B * ln_N_factorial\n    return S", "def formula(var_N):\n    # Boltzmann constant (exact value as specified)\n    k_B = 1.381e-23\n    # Entropy as a function of number of microstates/configurations N\n    import numpy as np\n    S = k_B * np.log(var_N)\n    return S", "def formula(var_N):\n    import numpy as np\n    # Poisson probability P(N) = e^(-N) * N^N / N!\n    # Using log-space computation for numerical stability\n    # ln(P) = -N + N*ln(N) - ln(N!)\n    # Using Stirling: ln(N!) \u2248 N*ln(N) - N + 0.5*ln(2*pi*N)\n    var_N = np.asarray(var_N, dtype=float)\n    # Exact computation using log-gamma (Stirling generalization)\n    # ln(N!) = lgamma(N+1)\n    log_prob = -var_N + var_N * np.log(np.maximum(var_N, 1e-300)) - (\n        var_N * np.log(np.maximum(var_N, 1e-300)) - var_N + 0.5 * np.log(2 * np.pi * np.maximum(var_N, 1e-300))\n    )\n    # Simplifies to Stirling approximation result\n    result = 1.0 / np.sqrt(2 * np.pi * np.maximum(var_N, 1e-300))\n    return result"], "candidate_train_r2": [-6.1252239574928335, -6.1252239574928335, -6.119623609995338], "candidate_r2_status": ["ok", "ok", "ok"], "candidate_extrap_r2_near": [-181.34342003226698, -181.34342003226698, -181.25881953997825], "candidate_extrap_r2_medium": [-6.566685855295777, -6.566685855295777, -6.562846206766985], "candidate_extrap_r2_far": [-11.233620402640067, -11.233620402640067, -11.233781254658663], "candidate_r2_raw_far": [-11.233620402640067, -11.233620402640067, -11.233781254658663], "selected_index": 2, "selection_metric": "train_r2", "model_id_returned": "claude-sonnet-4-6", "effective_request_params": {"params": {"model": "claude-sonnet-4-6", "max_tokens": 2000, "temperature": 0.3}, "temperature_sent": true, "model_requested": "claude-sonnet-4-6", "api_requests_per_call": [1, 1, 1], "stop_reasons": ["end_turn", "end_turn", "end_turn"], "prompt_identical_across_calls": true, "c